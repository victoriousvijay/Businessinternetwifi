# Copy this file to ".env" and fill in your real values.

PORT=3000

# ---- Where customer queries are delivered -------------------------------
# Every form submission (contact, quote, availability, AI-advisor message)
# is emailed to this address.
COMPANY_EMAIL=leads@businessinternetwifi.com

# ---- SMTP account used to SEND those emails -----------------------------
# Hostinger: smtp.hostinger.com, port 465, SSL (user = the full mailbox address, pass = its password).
# Gmail example: host smtp.gmail.com, port 465, secure true,
# user = your gmail address, pass = a Google "App Password" (not your login password).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=leads@businessinternetwifi.com
SMTP_PASS=your-mailbox-password
# Shown as the sender. Defaults to SMTP_USER if left empty.
MAIL_FROM="BusinessInternetWifi <leads@businessinternetwifi.com>"

# Send the customer a short "we got your request" email too (true/false)
AUTO_REPLY=true

# ---- Advisory Leads dashboard (/admin) ----------------------------------
# Pick a long random string. It is the access code for the leads page.
ADMIN_KEY=change-me-to-a-long-random-code
